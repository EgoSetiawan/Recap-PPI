{
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@tailwindcss/cli": "^4.3.3",
    "daisyui": "^5.7.47",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3"
  },
  "scripts": {
    "frontend": "npx --yes serve frontend -p 5173",
    "api": "cd backend && go run ./cmd/api",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose stop db",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "seed": "cd backend && go run ./cmd/seed",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "qa:backend": "go -C backend test ./... && go -C backend vet ./...",
    "qa:frontend": "eslint . && prettier . --check",
    "qa": "go -C backend test ./... && go -C backend vet ./... && eslint . && prettier . --check",
    "qa:watch": "bash scripts/qa-watch.sh",
    "qa:watch:verbose": "bash scripts/qa-watch.sh --verbose",
    "css:watch": "bunx @tailwindcss/cli -i ./frontend/assets/css/input.css -o ./frontend/assets/css/app.css --watch",
    "css:theme": "bunx @tailwindcss/cli -i ./frontend/assets/css/theme.src.css -o ./frontend/assets/css/theme.css",
    "css:theme:watch": "bunx @tailwindcss/cli -i ./frontend/assets/css/theme.src.css -o ./frontend/assets/css/theme.css --watch"
  }
}
