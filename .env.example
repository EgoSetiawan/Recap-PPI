# Copy to .env and adjust for your machine: `cp .env.example .env`
#
# The same file drives both the Docker stack and local `go run`/`npm` runs.

# Application
APP_ENV=development
PORT=3001
JWT_SECRET=change-me-dev-secret-rsu-koesnadi
JWT_TTL_HOURS=24
CORS_ORIGINS=http://localhost:5173
# Seed data is optional. docker-compose mounts ./mockoon at /app/seed and reads
# /app/seed/seed.json; local runs resolve this path from the backend directory.
SEED_PATH=../mockoon/seed.json

# Database (POSTGRES_* create the container DB; DATABASE_URL is what the API uses)
POSTGRES_USER=teguh
POSTGRES_PASSWORD=teguh
POSTGRES_DB=teguh
POSTGRES_PORT=5433
DATABASE_URL=postgres://teguh:teguh@localhost:5433/teguh?sslmode=disable

# Frontend served by nginx: "/api" uses the built-in proxy to the api service.
API_BASE_URL=/api
APP_NAME=Penilaian Ruangan
